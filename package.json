{
	"name": "max-green-api-chat",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=22.13.0"
	},
	"scripts": {
		"dev": "node --import ./scripts/runtime-env.mjs ./node_modules/vinext/dist/cli.js dev --port 5173",
		"build": "node --import ./scripts/runtime-env.mjs ./node_modules/vinext/dist/cli.js build",
		"start": "node --import ./scripts/runtime-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
		"test": "node --experimental-strip-types --test tests/*.test.mjs",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"login:cloudflare": "node scripts/cloudflare.mjs login",
		"deploy:cloudflare": "npm run build && node scripts/cloudflare.mjs deploy"
	},
	"dependencies": {
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"lucide-react": "^1.31.0",
		"next": "16.3.4",
		"radix-ui": "^1.6.7",
		"react": "19.2.6",
		"react-dom": "19.2.6",
		"tailwind-merge": "3.6.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.37.1",
		"@cloudflare/workers-types": "4.20260515.1",
		"@tailwindcss/postcss": "4.2.1",
		"@types/node": "22.19.19",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.2",
		"@vitejs/plugin-rsc": "0.5.26",
		"react-server-dom-webpack": "19.2.6",
		"tailwindcss": "4.2.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "5.9.3",
		"vinext": "1.0.0-beta.5",
		"vite": "8.0.13",
		"wrangler": "4.92.0",
		"prettier": "3.6.2"
	},
	"type": "module",
	"overrides": {
		"miniflare": {
			"sharp": "0.35.4"
		}
	}
}
